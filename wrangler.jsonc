{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offerte-casa-risparmio",
  "main": "api/worker.js",
  "compatibility_date": "2026-08-06",

  "kv_namespaces": [
    {
      "binding": "OFFERS",
      "id": "ab1d652ef6b94845af65b4bc0cf96391"
    }
  ],

  "assets": {
    "directory": ".",
    "run_worker_first": [
      "/offers",
      "/status",
      "/setup",
      "/seed",
      "/telegram",
      "/image"
    ]
  }
}


