{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offerte-casa-risparmio",
  "main": "api/worker.js",
  "compatibility_date": "2026-08-06",

  "routes": [
    { "pattern": "casarisparmio.info", "custom_domain": true }
  ],

  "triggers": {
    "crons": ["*/2 * * * *"]
  },

  "kv_namespaces": [
    {
      "binding": "OFFERS",
      "id": "ab1d652ef6b94845af65b4bc0cf96391"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },

  "assets": {
    "directory": ".",
    "run_worker_first": [
      "/offers",
      "/articles",
      "/status",
      "/setup",
      "/seed",
      "/sync",
      "/telegram",
      "/telegram-articles",
      "/image",
      "/product",
      "/push/onesignal/OneSignalSDKWorker.js",
      "/push/onesignal/OneSignalSDKUpdaterWorker.js"
    ]
  }
}
